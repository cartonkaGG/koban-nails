# Supabase — залиште ПОРОЖНІМИ для демо-режиму на Vercel (вхід без magic link)
# Заповнюйте лише після створення проєкту на supabase.com і виконання supabase/schema.sql
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=https://koban-nails.beauty

# Server-only canonical URL for auth emails (optional override)
SITE_URL=https://koban-nails.beauty

# Server-only. Add in Vercel as Sensitive. Never prefix this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated admin emails, for example:
# ADMIN_EMAILS=kobanarseniy@gmail.com,another@email.com
ADMIN_EMAILS=

# Resend — email (підтвердження реєстрації, зміна пароля, покупка)
# https://resend.com/api-keys
RESEND_API_KEY=
# Після верифікації домену koban-nails.beauty у Resend:
RESEND_FROM_EMAIL=Koban nails <noreply@koban-nails.beauty>
